{
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/portfolio-ai",      "destination": "/api/portfolio-ai.js" },
    { "source": "/api/rebalance-ai",      "destination": "/api/rebalance-ai.js" },
    { "source": "/api/request-document",  "destination": "/api/admin-save.js" },
    { "source": "/agents",         "destination": "/agents.html" },
    { "source": "/board",          "destination": "/board.html" },
    { "source": "/calendar",       "destination": "/calendar.html" },
    { "source": "/plan",           "destination": "/plan.html" },
    { "source": "/pipeline",       "destination": "/pipeline.html" },
    { "source": "/funds",          "destination": "/funds.html" },
    { "source": "/elearning",      "destination": "/elearning.html" },
    { "source": "/estate-planning","destination": "/estate-planning.html" },
    { "source": "/financial-planning","destination": "/financial-planning.html" },
    { "source": "/factfinding",    "destination": "/factfinding.html" },
    { "source": "/islamic-finance","destination": "/islamic-finance.html" },
    { "source": "/client-care",    "destination": "/client-care.html" },
    { "source": "/hibah",           "destination": "/hibah.html" },
    { "source": "/nuzriah",         "destination": "/nuzriah.html" },
    { "source": "/wasiat",          "destination": "/wasiat.html" },
    { "source": "/memorandum",     "destination": "/memorandum.html" },
    { "source": "/will",           "destination": "/will.html" },
    { "source": "/deed-of-gift",   "destination": "/deed-of-gift.html" },
    { "source": "/estate-check",        "destination": "/estate-check.html" },
    { "source": "/estate-check/",       "destination": "/estate-check.html" },
    { "source": "/when-i-pass-away",    "destination": "/when-i-pass-away.html" },
    { "source": "/(.*)",                "destination": "/index.html" }
  ]
}
